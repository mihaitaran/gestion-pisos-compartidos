@page "/incidencias"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService

@if (viviendas.Count > 0)
{
    <MudSelect T="int" Value="viviendaFiltro" Label="Filtrar por vivienda" Variant="Variant.Outlined" Class="mb-4" Style="max-width: 400px;" ValueChanged="FiltrarIncidencias">
        <MudSelectItem Value="0">Todas las viviendas</MudSelectItem>
        @foreach (var v in viviendas)
        {
            <MudSelectItem Value="@v.Id">@v.Calle - @v.Ciudad</MudSelectItem>
        }
    </MudSelect>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => mensaje = string.Empty">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (viviendas.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">No tienes viviendas creadas.</MudAlert>
}
else if (incidencias.Count == 0)
{
    <MudAlert Severity="Severity.Normal">No hay incidencias registradas.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var i in incidenciasFiltradas)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudChip T="string" Size="Size.Small" Color="@ColorHelper.GetPrioridadColor(i.Prioridad)">@i.Prioridad</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="@ColorHelper.GetEstadoIncidenciaColor(i.Estado ?? "")">@i.Estado</MudChip>
                        </div>
                        <MudText Typo="Typo.h6">@i.Titulo</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@i.Vivienda?.Calle</MudText>
                        <MudText Typo="Typo.body2">@i.ReportadaPor?.Nombre @i.ReportadaPor?.Apellidos</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatHelper.FormatFecha(i.FechaCreacion)</MudText>
                    </MudCardContent>
                    @if (i.Estado != "Resuelta" && i.Estado != "Cerrada")
                    {
                        <MudCardActions>
                            <MudSelect T="string" Label="Cambiar estado" Variant="Variant.Outlined" Dense="true"
                                       ValueChanged="@((string val) => CambiarEstado(i.Id, val))">
                                <MudSelectItem Value="@("Abierta")">Abierta</MudSelectItem>
                                <MudSelectItem Value="@("EnProceso")">En proceso</MudSelectItem>
                                <MudSelectItem Value="@("Resuelta")">Resuelta</MudSelectItem>
                                <MudSelectItem Value="@("Cerrada")">Cerrada</MudSelectItem>
                            </MudSelect>
                        </MudCardActions>
                    }
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<IncidenciaDTO> incidencias = new();
    private bool cargando = true;
    private string mensaje = "";
    private List<ViviendaDTO> viviendas = new();
    private int viviendaFiltro = 0;
    private List<IncidenciaDTO> incidenciasFiltradas = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarIncidencias();
            StateHasChanged();
        }
    }

    private async Task CargarIncidencias()
    {
        cargando = true;
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user != null)
            {
                viviendas = await Http.GetFromJsonAsync<List<ViviendaDTO>>($"api/viviendas/propietario/{user.UsuarioId}") ?? new();
                incidencias = new();
                foreach (var v in viviendas)
                {
                    var inc = await Http.GetFromJsonAsync<List<IncidenciaDTO>>($"api/incidencias/vivienda/{v.Id}") ?? new();
                    incidencias.AddRange(inc);
                }
                incidenciasFiltradas = incidencias;
            }
        }
        catch
        {
            mensaje = "Error al cargar incidencias";
        }
        cargando = false;
    }

    private void FiltrarIncidencias(int viviendaId)
    {
        viviendaFiltro = viviendaId;
        incidenciasFiltradas = viviendaId == 0
            ? incidencias
            : incidencias.Where(i => i.ViviendaId == viviendaId).ToList();
    }

    private async Task CambiarEstado(int id, string nuevoEstado)
    {
        if (string.IsNullOrEmpty(nuevoEstado)) return;

        try
        {
            var response = await Http.PatchAsJsonAsync($"api/incidencias/{id}/estado", nuevoEstado);

            if (response.IsSuccessStatusCode)
            {
                mensaje = "Estado actualizado";
            }
            else
            {
                mensaje = "Error al actualizar";
            }

            await CargarIncidencias();
        }
        catch
        {
            mensaje = "Error al cambiar estado";
        }
    }
}