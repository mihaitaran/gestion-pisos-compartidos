@page "/incidencias"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Incidencias</MudText>

@if (!cargando && incidencias.Count == 0 && viviendas.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">No tienes viviendas creadas.</MudAlert>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => mensaje = string.Empty">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (incidencias.Count == 0)
{
    <MudAlert Severity="Severity.Normal">No hay incidencias registradas.</MudAlert>
}
else
{
    <MudTable Items="@incidencias" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>Título</MudTh>
            <MudTh>Vivienda</MudTh>
            <MudTh>Reportada por</MudTh>
            <MudTh>Prioridad</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Fecha</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Titulo</MudTd>
            <MudTd>@context.Vivienda?.Direccion</MudTd>
            <MudTd>@context.ReportadaPor?.Nombre @context.ReportadaPor?.Apellidos</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetPrioridadColor(context.Prioridad)">@context.Prioridad</MudChip>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetEstadoColor(context.Estado ?? "")">@context.Estado</MudChip>
            </MudTd>
            <MudTd>@context.FechaCreacion</MudTd>
            <MudTd>
                @if (context.Estado != "Resuelta" && context.Estado != "Cerrada")
                {
                    <MudSelect T="string" Label="Cambiar" Variant="Variant.Outlined" Dense="true"
                               ValueChanged="@((string val) => CambiarEstado(context.Id, val))">
                        <MudSelectItem Value="@("Abierta")">Abierta</MudSelectItem>
                        <MudSelectItem Value="@("EnProceso")">En proceso</MudSelectItem>
                        <MudSelectItem Value="@("Resuelta")">Resuelta</MudSelectItem>
                        <MudSelectItem Value="@("Cerrada")">Cerrada</MudSelectItem>
                    </MudSelect>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<IncidenciaDTO> incidencias = new();
    private bool cargando = true;
    private string mensaje = "";
    private List<ViviendaDTO> viviendas = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarIncidencias();
            StateHasChanged();
        }
    }

    private async Task CargarIncidencias()
    {
        cargando = true;
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user != null)
            {
                viviendas = await Http.GetFromJsonAsync<List<ViviendaDTO>>($"api/viviendas/propietario/{user.UsuarioId}") ?? new();
                incidencias = new();
                foreach (var v in viviendas)
                {
                    var inc = await Http.GetFromJsonAsync<List<IncidenciaDTO>>($"api/incidencias/vivienda/{v.Id}") ?? new();
                    incidencias.AddRange(inc);
                }
            }
        }
        catch
        {
            mensaje = "Error al cargar incidencias";
        }
        cargando = false;
    }

    private async Task CambiarEstado(int id, string nuevoEstado)
    {
        if (string.IsNullOrEmpty(nuevoEstado)) return;
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/incidencias/{id}/estado", nuevoEstado);
            mensaje = response.IsSuccessStatusCode ? "Estado actualizado" : "Error al actualizar";
            await CargarIncidencias();
        }
        catch
        {
            mensaje = "Error al cambiar estado";
        }
    }

    private Color GetPrioridadColor(string prioridad)
    {
        return prioridad switch
        {
            "Baja" => Color.Info,
            "Media" => Color.Warning,
            "Alta" => Color.Error,
            "Urgente" => Color.Error,
            _ => Color.Default
        };
    }

    private Color GetEstadoColor(string estado)
    {
        return estado switch
        {
            "Abierta" => Color.Error,
            "EnProceso" => Color.Warning,
            "Resuelta" => Color.Success,
            "Cerrada" => Color.Default,
            _ => Color.Default
        };
    }
}