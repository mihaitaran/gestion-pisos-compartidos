@page "/viviendas/{ViviendaId:int}/habitaciones"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Habitaciones</MudText>

<MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack"
           OnClick='() => Navigation.NavigateTo("/viviendas")' Class="mr-2 mb-4">Volver</MudButton>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="() => mostrarForm = !mostrarForm" Class="mb-4">
    @(mostrarForm ? "Cancelar" : "Añadir habitación")
</MudButton>

@if (mostrarForm)
{
    <MudCard Class="mb-4 pa-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">@(habitacionEditando != null ? "Editar habitación" : "Nueva habitación")</MudText>

            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="numero" Label="Número / Nombre" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="precioMensual" Label="Precio mensual (€)" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudCheckBox @bind-Value="tieneBano" Label="Tiene baño" Color="Color.Primary" Class="mt-3" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="descripcion" Label="Descripción" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="GuardarHabitacion" Class="mt-3">Guardar</MudButton>
        </MudCardContent>
    </MudCard>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => mensaje = string.Empty">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (habitaciones.Count == 0)
{
    <MudAlert Severity="Severity.Normal">No hay habitaciones registradas.</MudAlert>
}
else
{
    <MudTable Items="@habitaciones" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>Número</MudTh>
            <MudTh>Baño</MudTh>
            <MudTh>Descripción</MudTh>
            <MudTh>Precio mensual</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Numero</MudTd>
            <MudTd>
                <MudIcon Icon="@(context.TieneBano ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                         Color="@(context.TieneBano ? Color.Success : Color.Error)" Size="Size.Small" />
            </MudTd>
            <MudTd>@context.Descripcion</MudTd>
            <MudTd>@(context.PrecioMensual?.ToString("F2") ?? "-") €</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Warning" OnClick="() => EditarHabitacion(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => EliminarHabitacion(context.Id)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter]
    public int ViviendaId { get; set; }

    private List<HabitacionDTO> habitaciones = new();
    private bool cargando = true;
    private bool mostrarForm = false;
    private string mensaje = "";
    private HabitacionDTO? habitacionEditando = null;

    private string numero = "";
    private bool tieneBano = false;
    private string descripcion = "";
    private decimal precioMensual = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarHabitaciones();
            StateHasChanged();
        }
    }

    private async Task CargarHabitaciones()
    {
        cargando = true;
        try
        {
            habitaciones = await Http.GetFromJsonAsync<List<HabitacionDTO>>($"api/habitaciones/vivienda/{ViviendaId}") ?? new();
        }
        catch
        {
            mensaje = "Error al cargar habitaciones";
        }
        cargando = false;
    }

    private async Task GuardarHabitacion()
    {
        try
        {
            if (habitacionEditando != null)
            {
                var data = new { Numero = numero, TieneBano = tieneBano, Descripcion = descripcion, PrecioMensual = precioMensual };
                var response = await Http.PutAsJsonAsync($"api/habitaciones/{habitacionEditando.Id}", data);
                if (response.IsSuccessStatusCode)
                {
                    mensaje = "Habitación actualizada";
                    mostrarForm = false;
                    LimpiarFormulario();
                }
                else
                {
                    mensaje = "Error al actualizar";
                }
            }
            else
            {
                var data = new { ViviendaId = ViviendaId, Numero = numero, TieneBano = tieneBano, Descripcion = descripcion, PrecioMensual = precioMensual };
                var response = await Http.PostAsJsonAsync("api/habitaciones", data);
                if (response.IsSuccessStatusCode)
                {
                    mensaje = "Habitación creada";
                    mostrarForm = false;
                    LimpiarFormulario();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    mensaje = error.Contains("solo tiene") ? "No puedes crear más habitaciones. El límite es el número de habitaciones del piso." : "Error al crear";
                }
            }

            await CargarHabitaciones();
        }
        catch
        {
            mensaje = "Error al guardar";
        }
    }

    private void EditarHabitacion(HabitacionDTO h)
    {
        habitacionEditando = h;
        numero = h.Numero;
        tieneBano = h.TieneBano;
        descripcion = h.Descripcion ?? "";
        precioMensual = h.PrecioMensual ?? 0;
        mostrarForm = true;
    }

    private async Task EliminarHabitacion(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/habitaciones/{id}");
            mensaje = response.IsSuccessStatusCode ? "Habitación eliminada" : "Error al eliminar";
            await CargarHabitaciones();
        }
        catch
        {
            mensaje = "Error al eliminar";
        }
    }

    private void LimpiarFormulario()
    {
        habitacionEditando = null;
        numero = "";
        tieneBano = false;
        descripcion = "";
        precioMensual = 0;
    }
}