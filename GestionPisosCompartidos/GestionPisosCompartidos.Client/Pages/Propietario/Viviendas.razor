@page "/viviendas"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Mis viviendas</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="MostrarFormulario" Class="mb-4">
    @(mostrarForm ? "Cancelar" : "Añadir vivienda")
</MudButton>

@if (mostrarForm)
{
    <MudCard Class="mb-4 pa-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">@(viviendaEditando != null ? "Editar vivienda" : "Nueva vivienda")</MudText>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="direccion" Label="Dirección" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="ciudad" Label="Ciudad" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="codigoPostal" Label="Código postal" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="numHabitaciones" Label="Nº Habitaciones" Variant="Variant.Outlined" Min="1" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="descripcion" Label="Descripción" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="GuardarVivienda" Class="mt-3">Guardar</MudButton>
        </MudCardContent>
    </MudCard>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => mensaje = string.Empty">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (viviendas.Count == 0)
{
    <MudAlert Severity="Severity.Normal">No tienes viviendas registradas.</MudAlert>
}
else
{
    <MudTable Items="@viviendas" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>Dirección</MudTh>
            <MudTh>Ciudad</MudTh>
            <MudTh>C.P.</MudTh>
            <MudTh>Habitaciones</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Direccion</MudTd>
            <MudTd>@context.Ciudad</MudTd>
            <MudTd>@context.CodigoPostal</MudTd>
            <MudTd>@context.NumHabitaciones</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Warning" OnClick="() => EditarVivienda(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => EliminarVivienda(context.Id)" />
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info" OnClick='() => Navigation.NavigateTo($"/viviendas/{context.Id}/inquilinos")'>Inquilinos</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" OnClick='() => Navigation.NavigateTo($"/viviendas/{context.Id}/habitaciones")'>Habitaciones</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<ViviendaDTO> viviendas = new();
    private bool cargando = true;
    private bool mostrarForm = false;
    private string mensaje = "";
    private ViviendaDTO? viviendaEditando = null;

    private string direccion = "";
    private string ciudad = "";
    private string codigoPostal = "";
    private string descripcion = "";
    private int numHabitaciones = 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var autenticado = await AuthService.IsAuthenticatedAsync();
            if (!autenticado)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            await CargarViviendas();
            StateHasChanged();
        }
    }

    private async Task CargarViviendas()
    {
        cargando = true;
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user != null)
            {
                viviendas = await Http.GetFromJsonAsync<List<ViviendaDTO>>($"api/viviendas/propietario/{user.UsuarioId}") ?? new();
            }
        }
        catch
        {
            mensaje = "Error al cargar las viviendas";
        }
        cargando = false;
    }

    private void MostrarFormulario()
    {
        mostrarForm = !mostrarForm;
        if (!mostrarForm) LimpiarFormulario();
    }

    private async Task GuardarVivienda()
    {
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user == null) return;

            if (viviendaEditando != null)
            {
                var data = new
                {
                    Direccion = direccion,
                    Ciudad = ciudad,
                    CodigoPostal = codigoPostal,
                    Descripcion = descripcion,
                    NumHabitaciones = numHabitaciones
                };
                var response = await Http.PutAsJsonAsync($"api/viviendas/{viviendaEditando.Id}", data);
                mensaje = response.IsSuccessStatusCode ? "Vivienda actualizada" : "Error al actualizar";
            }
            else
            {
                var data = new
                {
                    Direccion = direccion,
                    Ciudad = ciudad,
                    CodigoPostal = codigoPostal,
                    Descripcion = descripcion,
                    NumHabitaciones = numHabitaciones,
                    PropietarioId = user.UsuarioId
                };
                var response = await Http.PostAsJsonAsync("api/viviendas", data);
                mensaje = response.IsSuccessStatusCode ? "Vivienda creada" : "Error al crear";
            }

            mostrarForm = false;
            LimpiarFormulario();
            await CargarViviendas();
        }
        catch
        {
            mensaje = "Error al guardar";
        }
    }

    private void EditarVivienda(ViviendaDTO v)
    {
        viviendaEditando = v;
        direccion = v.Direccion;
        ciudad = v.Ciudad;
        codigoPostal = v.CodigoPostal;
        descripcion = v.Descripcion ?? "";
        numHabitaciones = v.NumHabitaciones;
        mostrarForm = true;
    }

    private async Task EliminarVivienda(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/viviendas/{id}");
            mensaje = response.IsSuccessStatusCode ? "Vivienda eliminada" : "Error al eliminar";
            await CargarViviendas();
        }
        catch
        {
            mensaje = "Error al eliminar";
        }
    }

    private void LimpiarFormulario()
    {
        viviendaEditando = null;
        direccion = "";
        ciudad = "";
        codigoPostal = "";
        descripcion = "";
        numHabitaciones = 1;
    }
}