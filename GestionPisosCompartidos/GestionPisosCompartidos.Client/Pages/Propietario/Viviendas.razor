@page "/viviendas"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Mis viviendas</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="MostrarFormulario" Class="mb-4" Disabled="@cargando">
    @(mostrarForm ? "Cancelar" : "Añadir vivienda")
</MudButton>

@if (mostrarForm)
{
    <MudCard Class="mb-4 pa-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">@(viviendaEditando != null ? "Editar vivienda" : "Nueva vivienda")</MudText>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="SugerenciaDireccionDTO"
                                     Label="Dirección (calle)"
                                     Variant="Variant.Outlined"
                                     SearchFunc="BuscarDirecciones"
                                     ToStringFunc="@(s => s == null ? "" : $"{s.Calle}, {s.Ciudad} {s.CodigoPostal}")"
                                     ValueChanged="SeleccionarDireccion"
                                     DebounceInterval="500"
                                     MinCharacters="3"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudTextField @bind-Value="numero" Label="Número" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudTextField @bind-Value="piso" Label="Piso" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6" sm="1">
                    <MudTextField @bind-Value="puerta" Label="Puerta" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="ciudad" Label="Ciudad" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="codigoPostal" Label="Código postal" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="descripcion" Label="Descripción" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="GuardarVivienda" Class="mt-3">Guardar</MudButton>
        </MudCardContent>
    </MudCard>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => mensaje = string.Empty">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (viviendas.Count == 0)
{
    <MudAlert Severity="Severity.Normal">No tienes viviendas registradas.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var v in viviendas)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@v.Direccion @v.Numero</MudText>
                        @if (!string.IsNullOrEmpty(v.Piso) || !string.IsNullOrEmpty(v.Puerta))
                        {
                            <MudText Typo="Typo.body2">@v.Piso @v.Puerta</MudText>
                        }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@v.Ciudad — @v.CodigoPostal</MudText>
                        @if (!string.IsNullOrEmpty(v.Descripcion))
                        {
                            <MudText Typo="Typo.caption">@v.Descripcion</MudText>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Warning" OnClick="() => EditarVivienda(v)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => EliminarVivienda(v.Id)" />
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info" OnClick='() => Navigation.NavigateTo($"/viviendas/{v.Id}/inquilinos")'>Inquilinos</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<ViviendaDTO> viviendas = new();
    private bool cargando = true;
    private bool mostrarForm = false;
    private string mensaje = "";
    private ViviendaDTO? viviendaEditando = null;

    private string direccion = "";
    private string numero = "";
    private string piso = "";
    private string puerta = "";
    private string ciudad = "";
    private string codigoPostal = "";
    private string descripcion = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarViviendas();
            StateHasChanged();
        }
    }

    private async Task CargarViviendas()
    {
        cargando = true;
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user != null)
            {
                viviendas = await Http.GetFromJsonAsync<List<ViviendaDTO>>($"api/viviendas/propietario/{user.UsuarioId}") ?? new();
            }
        }
        catch
        {
            mensaje = "Error al cargar las viviendas";
        }
        cargando = false;
    }

    private void MostrarFormulario()
    {
        mostrarForm = !mostrarForm;
        if (!mostrarForm) LimpiarFormulario();
    }

    private async Task GuardarVivienda()
    {
        if (string.IsNullOrEmpty(direccion))
        {
            mensaje = "Introduce una dirección";
            return;
        }

        if (string.IsNullOrEmpty(ciudad))
        {
            mensaje = "Introduce una ciudad";
            return;
        }

        if (string.IsNullOrEmpty(codigoPostal))
        {
            mensaje = "Introduce un código postal";
            return;
        }

        try
        {
            var user = await AuthService.GetUserAsync();
            if (user == null) return;

            if (viviendaEditando != null)
            {
                var data = new
                {
                    Direccion = direccion,
                    Numero = numero,
                    Piso = piso,
                    Puerta = puerta,
                    Ciudad = ciudad,
                    CodigoPostal = codigoPostal,
                    Descripcion = descripcion
                };

                var response = await Http.PutAsJsonAsync($"api/viviendas/{viviendaEditando.Id}", data);

                if (response.IsSuccessStatusCode)
                {
                    mensaje = "Vivienda actualizada";
                    mostrarForm = false;
                    LimpiarFormulario();
                }
                else
                {
                    mensaje = "Error al actualizar";
                }
            }
            else
            {
                var data = new
                {
                    Direccion = direccion,
                    Numero = numero,
                    Piso = piso,
                    Puerta = puerta,
                    Ciudad = ciudad,
                    CodigoPostal = codigoPostal,
                    Descripcion = descripcion,
                    PropietarioId = user.UsuarioId
                };

                var response = await Http.PostAsJsonAsync("api/viviendas", data);

                if (response.IsSuccessStatusCode)
                {
                    mensaje = "Vivienda creada";
                    mostrarForm = false;
                    LimpiarFormulario();
                }
                else
                {
                    mensaje = "Error al crear";
                }
            }

            await CargarViviendas();
        }
        catch
        {
            mensaje = "Error al guardar";
        }
    }

    private void EditarVivienda(ViviendaDTO v)
    {
        viviendaEditando = v;
        direccion = v.Direccion;
        numero = v.Numero ?? "";
        piso = v.Piso ?? "";
        puerta = v.Puerta ?? "";
        ciudad = v.Ciudad;
        codigoPostal = v.CodigoPostal;
        descripcion = v.Descripcion ?? "";
        mostrarForm = true;
    }

    private async Task EliminarVivienda(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/viviendas/{id}");
            if (response.IsSuccessStatusCode)
            {
                mensaje = "Vivienda eliminada";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                if (error.Contains("inquilinos"))
                    mensaje = "No se puede eliminar una vivienda con inquilinos activos";
                else if (error.Contains("habitaciones"))
                    mensaje = "No se puede eliminar una vivienda con habitaciones. Elimina las habitaciones primero";
                else
                    mensaje = "Error al eliminar";
            }
            await CargarViviendas();
        }
        catch
        {
            mensaje = "Error al eliminar";
        }
    }

    private void LimpiarFormulario()
    {
        viviendaEditando = null;
        direccion = "";
        numero = "";
        piso = "";
        puerta = "";
        ciudad = "";
        codigoPostal = "";
        descripcion = "";
    }

    private async Task<IEnumerable<SugerenciaDireccionDTO>> BuscarDirecciones(string valor, CancellationToken token)
    {
        if (string.IsNullOrEmpty(valor) || valor.Length < 3) return new List<SugerenciaDireccionDTO>();

        try
        {
            var response = await Http.GetAsync($"api/lugares/autocompletar?direccion={Uri.EscapeDataString(valor)}&ciudad={Uri.EscapeDataString(ciudad)}");
            if (response.IsSuccessStatusCode)
                return await response.Content.ReadFromJsonAsync<List<SugerenciaDireccionDTO>>() ?? new();
        }
        catch { }

        return new List<SugerenciaDireccionDTO>();
    }

    private void SeleccionarDireccion(SugerenciaDireccionDTO s)
    {
        if (s == null) return;
        direccion = s.Calle;
        if (!string.IsNullOrEmpty(s.Numero)) numero = s.Numero;
        if (!string.IsNullOrEmpty(s.Ciudad)) ciudad = s.Ciudad;
        if (!string.IsNullOrEmpty(s.CodigoPostal)) codigoPostal = s.CodigoPostal;
    }

}