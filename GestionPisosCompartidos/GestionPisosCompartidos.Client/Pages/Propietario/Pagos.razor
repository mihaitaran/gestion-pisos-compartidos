@page "/pagos"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Estado de pagos</MudText>

<MudSelect T="int" Value="viviendaSeleccionada" Label="Filtrar por vivienda" Variant="Variant.Outlined"
           Class="mb-4" Style="max-width: 400px;"
           ValueChanged="@((int val) => { viviendaSeleccionada = val; CargarPagos(); })">
    <MudSelectItem Value="0">Todas las viviendas</MudSelectItem>
    @foreach (var v in viviendas)
    {
        <MudSelectItem Value="@v.Id">@v.Direccion - @v.Ciudad</MudSelectItem>
    }
</MudSelect>

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (pagos.Count == 0)
{
    <MudAlert Severity="Severity.Normal">No hay pagos registrados.</MudAlert>
}
else
{
    <MudTable Items="@pagos" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>Concepto</MudTh>
            <MudTh>Inquilino</MudTh>
            <MudTh>Importe</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Fecha pago</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Gasto?.Concepto</MudTd>
            <MudTd>@context.Inquilino?.Nombre @context.Inquilino?.Apellidos</MudTd>
            <MudTd>@context.Importe.ToString("F2") €</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetEstadoColor(context.Estado)">@context.Estado</MudChip>
            </MudTd>
            <MudTd>@(context.FechaPago ?? "-")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<PagoDTO> pagos = new();
    private List<ViviendaDTO> viviendas = new();
    private int viviendaSeleccionada = 0;
    private bool cargando = true;
    private string mensaje = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var autenticado = await AuthService.IsAuthenticatedAsync();
            if (!autenticado)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            await CargarViviendas();
            await CargarPagos();
            StateHasChanged();
        }
    }

    private async Task CargarViviendas()
    {
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user != null)
            {
                viviendas = await Http.GetFromJsonAsync<List<ViviendaDTO>>($"api/viviendas/propietario/{user.UsuarioId}") ?? new();
            }
        }
        catch
        {
            mensaje = "Error al cargar viviendas";
        }
    }

    private async Task CargarPagos()
    {
        cargando = true;
        try
        {
            if (viviendaSeleccionada > 0)
            {
                var gastos = await Http.GetFromJsonAsync<List<GastoDTO>>($"api/gastos/vivienda/{viviendaSeleccionada}") ?? new();
                pagos = gastos.SelectMany(g => g.Pagos.Select(p => new PagoDTO
                {
                    Id = p.Id, Importe = p.Importe, Estado = p.Estado, FechaPago = p.FechaPago,
                    Inquilino = p.Inquilino,
                    Gasto = new GastoDTO { Concepto = g.Concepto, Categoria = g.Categoria }
                })).ToList();
            }
            else
            {
                pagos = new();
                foreach (var v in viviendas)
                {
                    var gastos = await Http.GetFromJsonAsync<List<GastoDTO>>($"api/gastos/vivienda/{v.Id}") ?? new();
                    pagos.AddRange(gastos.SelectMany(g => g.Pagos.Select(p => new PagoDTO
                    {
                        Id = p.Id, Importe = p.Importe, Estado = p.Estado, FechaPago = p.FechaPago,
                        Inquilino = p.Inquilino,
                        Gasto = new GastoDTO { Concepto = g.Concepto, Categoria = g.Categoria }
                    })));
                }
            }
        }
        catch
        {
            mensaje = "Error al cargar pagos";
        }
        cargando = false;
    }

    private Color GetEstadoColor(string estado)
    {
        return estado switch
        {
            "Pagado" => Color.Success,
            "Pendiente" => Color.Warning,
            "Rechazado" => Color.Error,
            _ => Color.Default
        };
    }
}