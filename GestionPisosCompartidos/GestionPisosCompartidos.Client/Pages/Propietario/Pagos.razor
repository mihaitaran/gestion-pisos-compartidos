@page "/pagos"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService

<MudText Typo="Typo.h4" Class="mb-4">Estado de pagos</MudText>

<MudSelect T="int" Value="viviendaSeleccionada" Label="Filtrar por vivienda" Variant="Variant.Outlined" Class="mb-4" Style="max-width: 400px;" ValueChanged="CambiarVivienda">
    <MudSelectItem Value="0">Todas las viviendas</MudSelectItem>
    @foreach (var v in viviendas)
    {
        <MudSelectItem Value="@v.Id">@v.Calle - @v.Ciudad</MudSelectItem>
    }
</MudSelect>

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => mensaje = string.Empty">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (viviendas.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">No tienes viviendas creadas.</MudAlert>
}
else if (pagos.Count == 0)
{
    <MudAlert Severity="Severity.Normal">No hay pagos registrados.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var p in pagos)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudText Typo="Typo.h6">@p.Gasto?.Concepto</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@ColorHelper.GetEstadoColor(p.Estado)">@p.Estado</MudChip>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@p.Inquilino?.Nombre @p.Inquilino?.Apellidos</MudText>
                        <MudText Typo="Typo.body1" Class="mt-2"><b>@p.Importe.ToString("F2") €</b></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Pagado: @FormatHelper.FormatFecha(p.FechaPago)</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<PagoDTO> pagos = new();
    private List<ViviendaDTO> viviendas = new();
    private int viviendaSeleccionada = 0;
    private bool cargando = true;
    private string mensaje = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarViviendas();
            await CargarPagos();
            StateHasChanged();
        }
    }

    private async Task CargarViviendas()
    {
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user != null)
            {
                viviendas = await Http.GetFromJsonAsync<List<ViviendaDTO>>($"api/viviendas/propietario/{user.UsuarioId}") ?? new();
            }
        }
        catch
        {
            mensaje = "Error al cargar viviendas";
        }
    }

    private async Task CambiarVivienda(int nuevaVivienda)
    {
        viviendaSeleccionada = nuevaVivienda;
        await CargarPagos();
        StateHasChanged();
    }

    private async Task CargarPagos()
    {
        cargando = true;
        try
        {
            if (viviendaSeleccionada > 0)
            {
                var gastos = await Http.GetFromJsonAsync<List<GastoDTO>>($"api/gastos/vivienda/{viviendaSeleccionada}") ?? new();
                pagos = gastos.SelectMany(g => g.Pagos.Select(p => new PagoDTO
                {
                    Id = p.Id, Importe = p.Importe, Estado = p.Estado, FechaPago = p.FechaPago,
                    Inquilino = p.Inquilino,
                    Gasto = new GastoDTO { Concepto = g.Concepto, Categoria = g.Categoria }
                })).ToList();
            }
            else
            {
                pagos = new();
                foreach (var v in viviendas)
                {
                    var gastos = await Http.GetFromJsonAsync<List<GastoDTO>>($"api/gastos/vivienda/{v.Id}") ?? new();
                    pagos.AddRange(gastos.SelectMany(g => g.Pagos.Select(p => new PagoDTO
                    {
                        Id = p.Id, Importe = p.Importe, Estado = p.Estado, FechaPago = p.FechaPago,
                        Inquilino = p.Inquilino,
                        Gasto = new GastoDTO { Concepto = g.Concepto, Categoria = g.Categoria }
                    })));
                }
            }
        }
        catch
        {
            mensaje = "Error al cargar pagos";
        }
        cargando = false;
    }
}