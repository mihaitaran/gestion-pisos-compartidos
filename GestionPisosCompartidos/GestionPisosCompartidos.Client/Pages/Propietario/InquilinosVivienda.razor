@page "/viviendas/{ViviendaId:int}/inquilinos"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Inquilinos de la vivienda</MudText>

<MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack"
           OnClick='() => Navigation.NavigateTo("/viviendas")' Class="mr-2 mb-4">Volver</MudButton>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
           OnClick="() => mostrarForm = !mostrarForm" Class="mb-4">
    @(mostrarForm ? "Cancelar" : "Añadir inquilino")
</MudButton>

@if (mostrarForm)
{
    <MudCard Class="mb-4 pa-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">Asignar inquilino</MudText>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="emailInquilino" Label="Email del inquilino" Variant="Variant.Outlined"
                                  InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="habitacionSeleccionada" Label="Habitación (opcional)" Variant="Variant.Outlined">
                        <MudSelectItem Value="0">Sin habitación asignada</MudSelectItem>
                        @foreach (var h in habitaciones)
                        {
                            <MudSelectItem Value="@h.Id">@h.Numero - @(h.TieneBano ? "Con baño" : "Sin baño") - @(h.PrecioMensual?.ToString("F2") ?? "0") €</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AsignarInquilino" Class="mt-3">Asignar</MudButton>
        </MudCardContent>
    </MudCard>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => mensaje = string.Empty">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (inquilinos.Count == 0)
{
    <MudAlert Severity="Severity.Normal">No hay inquilinos asignados.</MudAlert>
}
else
{
    <MudTable Items="@inquilinos" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Habitación</MudTh>
            <MudTh>Fecha inicio</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Inquilino?.Nombre @context.Inquilino?.Apellidos</MudTd>
            <MudTd>@context.Inquilino?.Email</MudTd>
            <MudTd>@(context.Habitacion?.Numero ?? "Sin asignar")</MudTd>
            <MudTd>@context.FechaInicio</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.Activo ? Color.Success : Color.Default)">
                    @(context.Activo ? "Activo" : "Inactivo")
                </MudChip>
            </MudTd>
            <MudTd>
                @if (context.Activo)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                               OnClick="() => DesactivarInquilino(context.Id)">Desactivar</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter]
    public int ViviendaId { get; set; }

    private List<InquilinoViviendaDTO> inquilinos = new();
    private List<HabitacionDTO> habitaciones = new();
    private bool cargando = true;
    private bool mostrarForm = false;
    private string emailInquilino = "";
    private int habitacionSeleccionada = 0;
    private string mensaje = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var autenticado = await AuthService.IsAuthenticatedAsync();
            if (!autenticado)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            await CargarDatos();
            StateHasChanged();
        }
    }

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            inquilinos = await Http.GetFromJsonAsync<List<InquilinoViviendaDTO>>($"api/inquilinosviviendas/vivienda/{ViviendaId}") ?? new();
            habitaciones = await Http.GetFromJsonAsync<List<HabitacionDTO>>($"api/habitaciones/vivienda/{ViviendaId}") ?? new();
        }
        catch
        {
            mensaje = "Error al cargar datos";
        }
        cargando = false;
    }

    private async Task AsignarInquilino()
    {
        try
        {
            var usuarios = await Http.GetFromJsonAsync<List<UsuarioDTO>>("api/usuarios") ?? new();
            var inquilino = usuarios.FirstOrDefault(u => u.Email == emailInquilino && u.Rol == "Inquilino");

            if (inquilino == null)
            {
                mensaje = "No se encontró un inquilino con ese email";
                return;
            }

            var data = new
            {
                InquilinoId = inquilino.Id,
                ViviendaId = ViviendaId,
                HabitacionId = habitacionSeleccionada > 0 ? habitacionSeleccionada : (int?)null
            };

            var response = await Http.PostAsJsonAsync("api/inquilinosviviendas", data);
            mensaje = response.IsSuccessStatusCode ? "Inquilino asignado" : "Error al asignar";
            mostrarForm = false;
            emailInquilino = "";
            habitacionSeleccionada = 0;
            await CargarDatos();
        }
        catch
        {
            mensaje = "Error al asignar inquilino";
        }
    }

    private async Task DesactivarInquilino(int id)
    {
        try
        {
            var response = await Http.PatchAsync($"api/inquilinosviviendas/{id}/desactivar", null);
            mensaje = response.IsSuccessStatusCode ? "Inquilino desactivado" : "Error al desactivar";
            await CargarDatos();
        }
        catch
        {
            mensaje = "Error al desactivar";
        }
    }
}