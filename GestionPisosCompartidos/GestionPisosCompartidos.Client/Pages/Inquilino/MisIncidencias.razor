@page "/mis-incidencias"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService


<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="() => mostrarForm = !mostrarForm" Class="mb-4"
           Disabled="@(viviendaActiva == null)">
    @(mostrarForm ? "Cancelar" : "Reportar incidencia")
</MudButton>

@if (mostrarForm)
{
    <MudCard Class="mb-4 pa-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">Nueva incidencia</MudText>

            @if (viviendaActiva != null)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    Vivienda: @viviendaActiva.Calle - @viviendaActiva.Ciudad
                </MudAlert>
            }

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="titulo" Label="Título" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="prioridad" Label="Prioridad" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Baja")">Baja</MudSelectItem>
                        <MudSelectItem Value="@("Media")">Media</MudSelectItem>
                        <MudSelectItem Value="@("Alta")">Alta</MudSelectItem>
                        <MudSelectItem Value="@("Urgente")">Urgente</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="descripcion" Label="Descripción" Variant="Variant.Outlined" Lines="3" />
                </MudItem>
            </MudGrid>

            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="CrearIncidencia" Class="mt-3">Enviar</MudButton>
        </MudCardContent>
    </MudCard>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => mensaje = string.Empty">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (viviendaActiva == null)
{
    <MudAlert Severity="Severity.Warning">No tienes una vivienda asignada.</MudAlert>
}
else if (incidencias.Count == 0)
{
    <MudAlert Severity="Severity.Normal">No has reportado incidencias.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var i in incidencias)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudChip T="string" Size="Size.Small" Color="@ColorHelper.GetPrioridadColor(i.Prioridad)">@i.Prioridad</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="@ColorHelper.GetEstadoIncidenciaColor(i.Estado ?? "")">@i.Estado</MudChip>
                        </div>
                        <MudText Typo="Typo.h6">@i.Titulo</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatHelper.FormatFecha(i.FechaCreacion)</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<IncidenciaDTO> incidencias = new();
    private ViviendaDTO? viviendaActiva = null;
    private int viviendaId = 0;
    private bool cargando = true;
    private bool mostrarForm = false;
    private string mensaje = "";

    private string titulo = "";
    private string descripcion = "";
    private string prioridad = "Media";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarDatos();
            StateHasChanged();
        }
    }

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user != null)
            {
                var todas = await Http.GetFromJsonAsync<List<InquilinoViviendaDTO>>($"api/inquilinosviviendas/inquilino/{user.UsuarioId}") ?? new();
                var activa = todas.FirstOrDefault(v => v.Activo);

                if (activa?.Vivienda != null)
                {
                    viviendaActiva = activa.Vivienda;
                    viviendaId = activa.ViviendaId;
                    incidencias = await Http.GetFromJsonAsync<List<IncidenciaDTO>>($"api/incidencias/vivienda/{viviendaId}") ?? new();
                }
            }
        }
        catch
        {
            mensaje = "Error al cargar datos";
        }
        cargando = false;
    }

    private async Task CrearIncidencia()
    {
        if (viviendaId == 0)
        {
            mensaje = "No tienes una vivienda asignada";
            return;
        }

        if (string.IsNullOrEmpty(titulo))
        {
            mensaje = "Añade un título";
            return;
        }

        if (string.IsNullOrEmpty(descripcion))
        {
            mensaje = "Añade una descripción";
            return;
        }

        try
        {
            var user = await AuthService.GetUserAsync();
            if (user == null) return;

            var data = new
            {
                ViviendaId = viviendaId,
                ReportadaPorId = user.UsuarioId,
                Titulo = titulo,
                Descripcion = descripcion,
                Prioridad = prioridad
            };

            var response = await Http.PostAsJsonAsync("api/incidencias", data);
            if (response.IsSuccessStatusCode)
            {
                mensaje = "Incidencia reportada";
                mostrarForm = false;
                titulo = "";
                descripcion = "";
                prioridad = "Media";
                await CargarDatos();
            }
            else
            {
                mensaje = "Error al crear incidencia";
            }
        }
        catch
        {
            mensaje = "Error al enviar";
        }
    }
}