@page "/mis-pagos"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService

<MudText Typo="Typo.h4" Class="mb-4">Mis pagos</MudText>

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => mensaje = string.Empty">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!tieneVivienda)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">No tienes una vivienda asignada.</MudAlert>
}
else if (pagos.Count == 0)
{
    <MudAlert Severity="Severity.Normal">No tienes pagos asignados.</MudAlert>
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Color="Color.Warning">Total pendiente</MudText>
                <MudText Typo="Typo.h5">@pagos.Where(p => p.Estado == "Pendiente").Sum(p => p.Importe).ToString("F2") €</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Color="Color.Success">Total pagado</MudText>
                <MudText Typo="Typo.h5">@pagos.Where(p => p.Estado == "Pagado").Sum(p => p.Importe).ToString("F2") €</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudTable Items="@pagos" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>Concepto</MudTh>
            <MudTh>Importe</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Fecha pago</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Gasto?.Concepto</MudTd>
            <MudTd>@context.Importe.ToString("F2") €</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@ColorHelper.GetEstadoColor(context.Estado)">@context.Estado</MudChip>
            </MudTd>
            <MudTd>@FormatHelper.FormatFecha(context.FechaPago)</MudTd>
            <MudTd>
                @if (context.Estado == "Pendiente")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="() => MarcarPagado(context.Id)">Pagado</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<PagoDTO> pagos = new();
    private bool cargando = true;
    private string mensaje = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarPagos();
            StateHasChanged();
        }
    }

    private bool tieneVivienda = false;

    private async Task CargarPagos()
    {
        cargando = true;
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user != null)
            {
                var asignaciones = await Http.GetFromJsonAsync<List<InquilinoViviendaDTO>>($"api/inquilinosviviendas/inquilino/{user.UsuarioId}") ?? new();
                tieneVivienda = asignaciones.Any(a => a.Activo);

                if (tieneVivienda)
                {
                    pagos = await Http.GetFromJsonAsync<List<PagoDTO>>($"api/pagos/inquilino/{user.UsuarioId}") ?? new();
                }
            }
        }
        catch
        {
            mensaje = "Error al cargar pagos";
        }
        cargando = false;
    }

    private async Task MarcarPagado(int id)
    {
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/pagos/{id}/estado", "Pagado");
            mensaje = response.IsSuccessStatusCode ? "Pago registrado" : "Error al registrar pago";
            await CargarPagos();
        }
        catch
        {
            mensaje = "Error al marcar como pagado";
        }
    }
}