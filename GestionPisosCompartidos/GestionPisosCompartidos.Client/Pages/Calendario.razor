@page "/calendario"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Calendario de tareas</MudText>

<MudGrid Class="mb-4">
    @if (rol == "Propietario")
    {
        <MudItem xs="12" sm="6">
            <MudSelect T="int" Value="viviendaSeleccionada" Label="Vivienda" Variant="Variant.Outlined"
                       ValueChanged="CambiarVivienda">
                <MudSelectItem Value="0">Selecciona vivienda</MudSelectItem>
                @foreach (var v in viviendas)
                {
                    <MudSelectItem Value="@v.Id">@v.Direccion - @v.Ciudad</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    }
    else if (viviendaActiva != null)
    {
        <MudItem xs="12" sm="6">
            <MudAlert Severity="Severity.Info">
                Vivienda: @viviendaActiva.Direccion - @viviendaActiva.Ciudad
            </MudAlert>
        </MudItem>
    }
    <MudItem xs="12" sm="6" Class="d-flex align-center">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="() => { mostrarForm = !mostrarForm; tareaEditando = null; LimpiarFormulario(); }"
                   Disabled="@(viviendaSeleccionada == 0)">
            @(mostrarForm ? "Cancelar" : "Nueva tarea")
        </MudButton>
    </MudItem>
</MudGrid>

@if (mostrarForm && viviendaSeleccionada > 0)
{
    <MudCard Class="mb-4 pa-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">@(tareaEditando != null ? "Editar tarea" : "Nueva tarea")</MudText>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="titulo" Label="Título" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="fechaProgramada" Label="Fecha programada" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="descripcion" Label="Descripción" Variant="Variant.Outlined" Lines="2" />
                </MudItem>
                @if (rol == "Propietario")
                {
                    <MudItem xs="12" sm="4">
                        <MudSelect T="int" @bind-Value="asignadaAId" Label="Asignar a" Variant="Variant.Outlined">
                            <MudSelectItem Value="0">Sin asignar</MudSelectItem>
                            @foreach (var iv in inquilinosVivienda)
                            {
                                <MudSelectItem Value="@iv.InquilinoId">@iv.Inquilino?.Nombre @iv.Inquilino?.Apellidos</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12" sm="4">
                    <MudCheckBox @bind-Value="recurrente" Label="Tarea recurrente" Color="Color.Primary" Class="mt-3" />
                </MudItem>
                @if (recurrente)
                {
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="frecuenciaDias" Label="Cada cuántos días" Variant="Variant.Outlined" Min="1" />
                    </MudItem>
                }
            </MudGrid>

            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="GuardarTarea" Class="mt-3">Guardar</MudButton>
        </MudCardContent>
    </MudCard>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => mensaje = string.Empty">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (viviendaSeleccionada == 0 && rol == "Propietario")
{
    <MudAlert Severity="Severity.Normal">Selecciona una vivienda para ver las tareas.</MudAlert>
}
else if (viviendaSeleccionada == 0 && rol == "Inquilino")
{
    <MudAlert Severity="Severity.Warning">No tienes una vivienda asignada.</MudAlert>
}
else
{
    <!-- Navegación del mes -->
    <MudPaper Class="d-flex align-center justify-center pa-3 mb-4" Elevation="2">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="MesAnterior" />
        <MudText Typo="Typo.h5" Class="mx-4">@mesActual.ToString("MMMM yyyy").ToUpper()</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="MesSiguiente" />
    </MudPaper>

    <!-- Cabecera días -->
    <MudGrid Spacing="0" Class="mb-1">
        @foreach (var dia in diasSemana)
        {
            <MudItem xs="0" Style="width: 14.28%; flex-basis: 14.28%; max-width: 14.28%;">
                <MudPaper Class="pa-2 text-center" Elevation="0" Style="background-color: #1565C0; color: white;">
                    <MudText Typo="Typo.subtitle2"><b>@dia</b></MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <!-- Días del mes -->
    <MudGrid Spacing="0">
        @foreach (var dia in diasDelMes)
        {
            var tareasDelDia = ObtenerTareasDia(dia);
            var esHoy = dia.Date == DateTime.Today;
            var esMesActual = dia.Month == mesActual.Month;

            <MudItem xs="0" Style="width: 14.28%; flex-basis: 14.28%; max-width: 14.28%;">
                <MudPaper Class="pa-2 calendario-celda" Elevation="1"
                          Style="@($"min-height: 100px; {(esHoy ? "border: 2px solid #1565C0;" : "")} {(!esMesActual ? "opacity: 0.4;" : "")}")">
                    <MudText Typo="Typo.caption" Class="@(esHoy ? "calendario-hoy" : "")">
                        <b>@dia.Day</b>
                    </MudText>
                    @foreach (var t in tareasDelDia)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(t.Completada ? Color.Success : Color.Primary)"
                                 Style="font-size: 0.7rem; margin: 2px 0; width: 100%;"
                                 OnClick="() => MostrarDetalleTarea(t)">
                            @(t.Titulo.Length > 12 ? t.Titulo.Substring(0, 12) + "..." : t.Titulo)
                        </MudChip>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <!-- Tareas pendientes -->
    @if (tareas.Any(t => !t.Completada))
    {
        <MudText Typo="Typo.h6" Class="mt-6 mb-2">Tareas pendientes</MudText>
        <MudGrid>
            @foreach (var t in tareas.Where(t => !t.Completada).OrderBy(t => t.FechaProgramada))
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudText Typo="Typo.h6">@t.Titulo</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@t.Descripcion</MudText>
                            <MudText Typo="Typo.caption" Class="mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" /> @t.FechaProgramada
                            </MudText>
                            @if (t.AsignadaA != null)
                            {
                                <MudText Typo="Typo.caption">Asignada a: @t.AsignadaA.Nombre @t.AsignadaA.Apellidos</MudText>
                            }
                            @if (t.Recurrente)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="mt-1">Cada @t.FrecuenciaDias días</MudChip>
                            }
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Check" OnClick="() => CompletarTarea(t.Id)"
                                       Disabled="@(!PuedeCompletar(t))">Completar</MudButton>
                            @if (rol == "Propietario" || t.CreadaPor?.Id == usuarioId)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Warning" OnClick="() => EditarTarea(t)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => EliminarTarea(t.Id)" />
                            }
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    @if (tareas.Any(t => t.Completada))
    {
        <MudText Typo="Typo.h6" Class="mt-6 mb-2">Completadas</MudText>
        <MudGrid>
            @foreach (var t in tareas.Where(t => t.Completada))
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="1" Style="opacity: 0.7;">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Style="text-decoration: line-through;">@t.Titulo</MudText>
                            <MudText Typo="Typo.caption">@t.FechaProgramada</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
}

<!-- Diálogo detalle -->
<MudDialog @bind-Visible="mostrarDetalle">
    <TitleContent>
        <MudText Typo="Typo.h6">@tareaDetalle?.Titulo</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-2">@tareaDetalle?.Descripcion</MudText>
        <MudText Typo="Typo.body2">Fecha: @tareaDetalle?.FechaProgramada</MudText>
        <MudText Typo="Typo.body2">Asignada a: @(tareaDetalle?.AsignadaA != null ? $"{tareaDetalle.AsignadaA.Nombre} {tareaDetalle.AsignadaA.Apellidos}" : "Sin asignar")</MudText>
        @if (tareaDetalle?.Recurrente == true)
        {
            <MudText Typo="Typo.body2">Se repite cada @tareaDetalle?.FrecuenciaDias días</MudText>
        }
        <MudChip T="string" Size="Size.Small" Color="@(tareaDetalle?.Completada == true ? Color.Success : Color.Warning)" Class="mt-2">
            @(tareaDetalle?.Completada == true ? "Completada" : "Pendiente")
        </MudChip>
    </DialogContent>
    <DialogActions>
        @if (tareaDetalle?.Completada == false)
        {
            <MudButton Color="Color.Success" OnClick="() => CompletarTarea(tareaDetalle!.Id)">Completar</MudButton>
        }
        @if (rol == "Propietario" || tareaDetalle?.CreadaPor?.Id == usuarioId)
        {
            <MudButton Color="Color.Warning" OnClick="() => { EditarTarea(tareaDetalle!); mostrarDetalle = false; }">Editar</MudButton>
        }
        <MudButton Color="Color.Default" OnClick="() => mostrarDetalle = false">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<TareaDTO> tareas = new();
    private List<ViviendaDTO> viviendas = new();
    private List<InquilinoViviendaDTO> inquilinosVivienda = new();
    private ViviendaDTO? viviendaActiva = null;
    private int viviendaSeleccionada = 0;
    private int usuarioId = 0;
    private string rol = "";
    private bool cargando = false;
    private bool mostrarForm = false;
    private bool mostrarDetalle = false;
    private string mensaje = "";
    private TareaDTO? tareaDetalle = null;
    private TareaDTO? tareaEditando = null;

    private string titulo = "";
    private string descripcion = "";
    private DateTime? fechaProgramada = DateTime.Today;
    private bool recurrente = false;
    private int frecuenciaDias = 7;
    private int asignadaAId = 0;

    private DateTime mesActual = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<DateTime> diasDelMes = new();
    private string[] diasSemana = { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var user = await AuthService.GetUserAsync();
            if (user != null)
            {
                usuarioId = user.UsuarioId;
                rol = user.Rol;

                if (rol == "Propietario")
                {
                    viviendas = await Http.GetFromJsonAsync<List<ViviendaDTO>>($"api/viviendas/propietario/{usuarioId}") ?? new();
                }
                else
                {
                    var asignaciones = await Http.GetFromJsonAsync<List<InquilinoViviendaDTO>>($"api/inquilinosviviendas/inquilino/{usuarioId}") ?? new();
                    var activa = asignaciones.FirstOrDefault(a => a.Activo);

                    if (activa?.Vivienda != null)
                    {
                        viviendaActiva = activa.Vivienda;
                        viviendaSeleccionada = activa.ViviendaId;
                        await CargarDatos();
                    }
                }
            }

            GenerarDiasMes();
            StateHasChanged();
        }
    }

    private async Task CambiarVivienda(int nuevaVivienda)
    {
        viviendaSeleccionada = nuevaVivienda;
        if (viviendaSeleccionada > 0)
            await CargarDatos();
        else
        {
            tareas = new();
            inquilinosVivienda = new();
        }
    }

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            tareas = await Http.GetFromJsonAsync<List<TareaDTO>>($"api/tareascalendario/vivienda/{viviendaSeleccionada}") ?? new();
            var todos = await Http.GetFromJsonAsync<List<InquilinoViviendaDTO>>($"api/inquilinosviviendas/vivienda/{viviendaSeleccionada}") ?? new();
            inquilinosVivienda = todos.Where(iv => iv.Activo).ToList();
        }
        catch
        {
            mensaje = "Error al cargar datos";
        }
        cargando = false;
    }

    private void GenerarDiasMes()
    {
        diasDelMes = new();
        var primerDia = new DateTime(mesActual.Year, mesActual.Month, 1);
        var ultimoDia = primerDia.AddMonths(1).AddDays(-1);

        var diaSemanaInicio = ((int)primerDia.DayOfWeek + 6) % 7;
        for (int i = diaSemanaInicio - 1; i >= 0; i--)
            diasDelMes.Add(primerDia.AddDays(-(i + 1)));

        for (var dia = primerDia; dia <= ultimoDia; dia = dia.AddDays(1))
            diasDelMes.Add(dia);

        while (diasDelMes.Count % 7 != 0)
            diasDelMes.Add(ultimoDia.AddDays(diasDelMes.Count - diasDelMes.IndexOf(ultimoDia)));
    }

    private void MesAnterior() { mesActual = mesActual.AddMonths(-1); GenerarDiasMes(); }
    private void MesSiguiente() { mesActual = mesActual.AddMonths(1); GenerarDiasMes(); }

    private List<TareaDTO> ObtenerTareasDia(DateTime dia)
    {
        var tareasDelDia = new List<TareaDTO>();

        foreach (var t in tareas)
        {
            if (DateTime.TryParse(t.FechaProgramada, out var fecha))
            {
                if (fecha.Date == dia.Date)
                {
                    tareasDelDia.Add(t);
                }
                else if (t.Recurrente && t.FrecuenciaDias > 0 && dia.Date >= fecha.Date && !t.Completada)
                {
                    var diferencia = (dia.Date - fecha.Date).Days;
                    if (diferencia > 0 && diferencia % t.FrecuenciaDias == 0)
                    {
                        tareasDelDia.Add(t);
                    }
                }
            }
        }

        return tareasDelDia;
    }

    private void MostrarDetalleTarea(TareaDTO tarea)
    {
        tareaDetalle = tarea;
        mostrarDetalle = true;
    }

    private void EditarTarea(TareaDTO t)
    {
        tareaEditando = t;
        titulo = t.Titulo;
        descripcion = t.Descripcion ?? "";
        if (DateTime.TryParse(t.FechaProgramada, out var fecha))
            fechaProgramada = fecha;
        recurrente = t.Recurrente;
        frecuenciaDias = t.FrecuenciaDias ?? 7;
        asignadaAId = t.AsignadaA?.Id ?? 0;
        mostrarForm = true;
    }

    private async Task GuardarTarea()
    {
        if (string.IsNullOrEmpty(titulo))
        {
            mensaje = "Añade un título";
            return;
        }

        try
        {
            if (tareaEditando != null)
            {
                var data = new
                {
                    Titulo = titulo,
                    Descripcion = descripcion,
                    FechaProgramada = fechaProgramada,
                    AsignadaAid = asignadaAId > 0 ? asignadaAId : (int?)null,
                    Recurrente = recurrente,
                    FrecuenciaDias = recurrente ? frecuenciaDias : (int?)null
                };
                var response = await Http.PutAsJsonAsync($"api/tareascalendario/{tareaEditando.Id}", data);
                if (response.IsSuccessStatusCode)
                {
                    mensaje = "Tarea actualizada";
                    mostrarForm = false;
                    LimpiarFormulario();
                }
                else
                {
                    mensaje = "Error al actualizar tarea";
                }
            }
            else
            {
                var data = new
                {
                    ViviendaId = viviendaSeleccionada,
                    Titulo = titulo,
                    Descripcion = descripcion,
                    FechaProgramada = fechaProgramada,
                    CreadaPorId = usuarioId,
                    AsignadaAid = rol == "Inquilino" ? usuarioId : (asignadaAId > 0 ? asignadaAId : (int?)null),
                    Recurrente = recurrente,
                    FrecuenciaDias = recurrente ? frecuenciaDias : (int?)null
                };
                var response = await Http.PostAsJsonAsync("api/tareascalendario", data);
                if (response.IsSuccessStatusCode)
                {
                    mensaje = "Tarea creada";
                    mostrarForm = false;
                    LimpiarFormulario();
                }
                else
                {
                    mensaje = "Error al crear tarea";
                }
            }

            await CargarDatos();
        }
        catch
        {
            mensaje = "Error al guardar";
        }
    }

    private async Task CompletarTarea(int id)
    {
        try
        {
            var response = await Http.PatchAsync($"api/tareascalendario/{id}/completar", null);
            mensaje = response.IsSuccessStatusCode ? "Tarea completada" : "Error al completar";
            mostrarDetalle = false;
            await CargarDatos();
        }
        catch
        {
            mensaje = "Error al completar tarea";
        }
    }

    private async Task EliminarTarea(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/tareascalendario/{id}");
            mensaje = response.IsSuccessStatusCode ? "Tarea eliminada" : "Error al eliminar";
            await CargarDatos();
        }
        catch
        {
            mensaje = "Error al eliminar";
        }
    }

    private void LimpiarFormulario()
    {
        tareaEditando = null;
        titulo = "";
        descripcion = "";
        fechaProgramada = DateTime.Today;
        recurrente = false;
        frecuenciaDias = 7;
        asignadaAId = 0;
    }

    private bool PuedeCompletar(TareaDTO t)
    {
        if (rol == "Propietario") return true;
        if (t.AsignadaA?.Id == usuarioId) return true;
        if (t.AsignadaA == null && t.CreadaPor?.Id == usuarioId) return true;
        return false;
    }
}