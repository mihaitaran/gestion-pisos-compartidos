@page "/perfil"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<MudText Typo="Typo.h4" Class="mb-4">Mi perfil</MudText>

@if (!string.IsNullOrEmpty(mensaje))
{
    <MudAlert Severity="@severidadMensaje" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => mensaje = string.Empty">@mensaje</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="pa-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-4">Información personal</MudText>

                    <MudTextField @bind-Value="nombre" Label="Nombre" Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField @bind-Value="apellidos" Label="Apellidos" Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField @bind-Value="telefono" Label="Teléfono" Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField Value="@email" Label="Email" Variant="Variant.Outlined" Class="mb-3"
                                  Disabled="true" />
                    <MudTextField Value="@rol" Label="Rol" Variant="Variant.Outlined" Class="mb-4"
                                  Disabled="true" />

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarPerfil"
                               Disabled="@guardando" Class="w-100">
                        @(guardando ? "Guardando..." : "Guardar cambios")
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="pa-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-4">Cambiar contraseña</MudText>

                    <MudTextField @bind-Value="passwordActual" Label="Contraseña actual" Variant="Variant.Outlined"
                                  InputType="InputType.Password" Class="mb-3" />
                    <MudTextField @bind-Value="passwordNueva" Label="Nueva contraseña" Variant="Variant.Outlined"
                                  InputType="InputType.Password" Class="mb-3" />
                    <MudTextField @bind-Value="passwordConfirmar" Label="Confirmar contraseña" Variant="Variant.Outlined"
                                  InputType="InputType.Password" Class="mb-4" />

                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="CambiarPassword"
                               Disabled="@guardando" Class="w-100">
                        @(guardando ? "Guardando..." : "Cambiar contraseña")
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private string nombre = "";
    private string apellidos = "";
    private string telefono = "";
    private string email = "";
    private string rol = "";
    private int usuarioId = 0;

    private string passwordActual = "";
    private string passwordNueva = "";
    private string passwordConfirmar = "";

    private bool cargando = true;
    private bool guardando = false;
    private string mensaje = "";
    private Severity severidadMensaje = Severity.Info;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarPerfil();
            StateHasChanged();
        }
    }

    private async Task CargarPerfil()
    {
        cargando = true;
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user != null)
            {
                usuarioId = user.UsuarioId;
                email = user.Email;
                rol = user.Rol;

                var usuario = await Http.GetFromJsonAsync<UsuarioDTO>($"api/usuarios/{usuarioId}");
                if (usuario != null)
                {
                    nombre = usuario.Nombre;
                    apellidos = usuario.Apellidos ?? "";
                    telefono = usuario.Telefono ?? "";
                }
            }
        }
        catch
        {
            mensaje = "Error al cargar el perfil";
            severidadMensaje = Severity.Error;
        }
        cargando = false;
    }

    private async Task GuardarPerfil()
    {
        if (string.IsNullOrEmpty(nombre))
        {
            mensaje = "El nombre no puede estar vacío";
            severidadMensaje = Severity.Warning;
            return;
        }

        guardando = true;
        try
        {
            var data = new { Nombre = nombre, Apellidos = apellidos, Telefono = telefono };
            var response = await Http.PatchAsJsonAsync($"api/usuarios/{usuarioId}/perfil", data);

            if (response.IsSuccessStatusCode)
            {
                mensaje = "Perfil actualizado correctamente";
                severidadMensaje = Severity.Success;

                var user = await AuthService.GetUserAsync();
                if (user != null)
                {
                    user.Nombre = nombre;
                    await LocalStorage.SetItemAsync("user_data", user);
                }

                Navigation.NavigateTo("/perfil", forceLoad: true);
            }
            else
            {
                mensaje = "Error al actualizar el perfil";
                severidadMensaje = Severity.Error;
            }
        }
        catch
        {
            mensaje = "Error al guardar";
            severidadMensaje = Severity.Error;
        }
        guardando = false;
    }

    private async Task CambiarPassword()
    {
        if (string.IsNullOrEmpty(passwordActual))
        {
            mensaje = "Introduce tu contraseña actual";
            severidadMensaje = Severity.Warning;
            return;
        }

        if (passwordNueva.Length < 8)
        {
            mensaje = "La contraseña debe tener al menos 8 caracteres";
            severidadMensaje = Severity.Warning;
            return;
        }

        if (!passwordNueva.Any(char.IsUpper))
        {
            mensaje = "La contraseña debe tener al menos una mayúscula";
            severidadMensaje = Severity.Warning;
            return;
        }

        if (!passwordNueva.Any(char.IsDigit))
        {
            mensaje = "La contraseña debe tener al menos un número";
            severidadMensaje = Severity.Warning;
            return;
        }

        if (!passwordNueva.Any(c => !char.IsLetterOrDigit(c)))
        {
            mensaje = "La contraseña debe tener al menos un símbolo";
            severidadMensaje = Severity.Warning;
            return;
        }

        if (passwordNueva != passwordConfirmar)
        {
            mensaje = "Las contraseñas no coinciden";
            severidadMensaje = Severity.Warning;
            return;
        }

        guardando = true;
        try
        {
            var data = new { PasswordActual = passwordActual, PasswordNueva = passwordNueva };
            var response = await Http.PatchAsJsonAsync($"api/usuarios/{usuarioId}/password", data);

            if (response.IsSuccessStatusCode)
            {
                mensaje = "Contraseña cambiada correctamente";
                severidadMensaje = Severity.Success;
                passwordActual = "";
                passwordNueva = "";
                passwordConfirmar = "";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensaje = error.Contains("incorrecta") ? "La contraseña actual es incorrecta" : "Error al cambiar la contraseña";
                severidadMensaje = Severity.Error;
            }
        }
        catch
        {
            mensaje = "Error al cambiar la contraseña";
            severidadMensaje = Severity.Error;
        }
        guardando = false;
    }
}