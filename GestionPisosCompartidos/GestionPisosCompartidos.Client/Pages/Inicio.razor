@page "/"
@using GestionPisosCompartidos.Client.Services
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

@if (usuario != null)
{
    <MudPaper Class="menu-welcome" Elevation="0">
        <MudText Typo="Typo.h4" Class="menu-welcome-title">Bienvenido, @usuario.Nombre</MudText>
        <MudText Typo="Typo.body1" Class="menu-welcome-subtitle">
            @(usuario.Rol == "Propietario" ? "Gestiona tus viviendas e inquilinos" : "Consulta tus pagos y tareas")
        </MudText>
    </MudPaper>

    @if (usuario.Rol == "Propietario")
    {
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/viviendas")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Mis viviendas</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Gestiona tus pisos</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/gastos")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Gastos</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Registra y reparte gastos</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/pagos")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Pagos</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Consulta el estado de pagos</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/incidencias")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Incidencias</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Revisa las incidencias</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/calendario")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Calendario</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Gestiona tareas de tus viviendas</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/chat")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Chat</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Comunícate con tus inquilinos</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/lugares")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Lugares cercanos</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Encuentra servicios cerca</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/perfil")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Mi perfil</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Edita tu información personal</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/gastos")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Gastos</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Registra gastos compartidos</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/mis-pagos")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Mis pagos</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Consulta tus pagos pendientes</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/mis-incidencias")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Incidencias</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Reporta y consulta incidencias</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/calendario")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Calendario</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Tareas y limpieza</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/chat")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Chat</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Comunícate con tus compañeros</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/lugares")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Lugares cercanos</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Encuentra servicios cerca</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="menu-card" @onclick='() => Navigation.NavigateTo("/perfil")'>
                    <MudCardContent Class="d-flex flex-column align-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6">Mi perfil</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Edita tu información personal</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
}

@code {
    private UserData? usuario;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            usuario = await AuthService.GetUserAsync();
            StateHasChanged();
        }
    }
}