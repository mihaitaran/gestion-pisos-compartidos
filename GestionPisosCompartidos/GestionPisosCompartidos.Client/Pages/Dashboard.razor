@page "/dashboard"
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

@if (usuario != null)
{
    <h2>Bienvenido, @usuario.Nombre</h2>

    @if (usuario.Rol == "Propietario")
    {
        <div class="dashboard-cards">
            <div class="card" @onclick='() => Navigation.NavigateTo("/viviendas")'>
                <h3>Mis viviendas</h3>
                <p>Gestiona tus pisos</p>
            </div>
            <div class="card" @onclick='() => Navigation.NavigateTo("/gastos")'>
                <h3>Gastos</h3>
                <p>Registra y reparte gastos</p>
            </div>
            <div class="card" @onclick='() => Navigation.NavigateTo("/pagos")'>
                <h3>Pagos</h3>
                <p>Consulta el estado de pagos</p>
            </div>
            <div class="card" @onclick='() => Navigation.NavigateTo("/incidencias")'>
                <h3>Incidencias</h3>
                <p>Revisa las incidencias</p>
            </div>
        </div>
    }
    else
    {
        <div class="dashboard-cards">
            <div class="card" @onclick='() => Navigation.NavigateTo("/mis-pagos")'>
                <h3>Mis pagos</h3>
                <p>Consulta tus pagos pendientes</p>
            </div>
            <div class="card" @onclick='() => Navigation.NavigateTo("/mis-incidencias")'>
                <h3>Incidencias</h3>
                <p>Reporta y consulta incidencias</p>
            </div>
            <div class="card" @onclick='() => Navigation.NavigateTo("/calendario")'>
                <h3>Calendario</h3>
                <p>Tareas y limpieza</p>
            </div>
        </div>
    }
}

@code {
    private GestionPisosCompartidos.Client.Services.UserData? usuario;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var autenticado = await AuthService.IsAuthenticatedAsync();
            if (!autenticado)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            usuario = await AuthService.GetUserAsync();
            StateHasChanged();
        }
    }
}