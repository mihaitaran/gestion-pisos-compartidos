@page "/register"
@layout EmptyLayout
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<div class="login-page">
    <div class="login-wrapper">
        <div class="login-image"></div>
        <div class="login-form">
            <MudText Typo="Typo.h4" Class="text-gradient mb-2" Align="Align.Center">RoomMate</MudText>
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Align="Align.Center" Class="mb-4">Crea tu cuenta</MudText>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@mensajeError</MudAlert>
            }

            @if (!string.IsNullOrEmpty(mensajeCorrecto))
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">@mensajeCorrecto</MudAlert>
            }

            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudTextField @bind-Value="nombre" Label="Nombre" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="apellidos" Label="Apellidos" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="email" Label="Email" Variant="Variant.Outlined" InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="password" Label="Contraseña" Variant="Variant.Outlined" InputType="InputType.Password" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="confirmPassword" Label="Confirmar" Variant="Variant.Outlined" InputType="InputType.Password" OnKeyDown="@(async (e) => { if (e.Key == "Enter") await Registro(); })" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="telefono" Label="Teléfono" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudSelect @bind-Value="rol" Label="Rol" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Propietario")">Propietario</MudSelectItem>
                        <MudSelectItem Value="@("Inquilino")">Inquilino</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                       OnClick="Registro" Disabled="@cargando"
                       Style="width: 100%; height: 48px; border-radius: 8px; font-size: 1rem;">
                @if (cargando)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Registrando...</span>
                }
                else
                {
                    <span>Registrarse</span>
                }
            </MudButton>

            <MudText Align="Align.Center" Class="mt-3">
                <MudLink Href="/login">¿Ya tienes cuenta? Inicia sesión</MudLink>
            </MudText>
        </div>
    </div>
</div>

@code {
    private string nombre = "";
    private string apellidos = "";
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private string telefono = "";
    private string rol = "";
    private string mensajeError = "";
    private string mensajeCorrecto = "";
    private bool cargando = false;

    private async Task Registro()
    {
        cargando = true;
        mensajeError = "";
        mensajeCorrecto = "";

        if (string.IsNullOrEmpty(nombre) || string.IsNullOrEmpty(apellidos))
        {
            mensajeError = "Introduce tu nombre y apellidos";
            cargando = false;
            return;
        }

        if (string.IsNullOrEmpty(email) || !email.Contains("@") || !email.Contains("."))
        {
            mensajeError = "Introduce un email válido";
            cargando = false;
            return;
        }

        if (password.Length < 8)
        {
            mensajeError = "La contraseña debe tener al menos 8 caracteres";
            cargando = false;
            return;
        }

        if (!password.Any(char.IsUpper))
        {
            mensajeError = "La contraseña debe tener al menos una mayúscula";
            cargando = false;
            return;
        }

        if (!password.Any(char.IsDigit))
        {
            mensajeError = "La contraseña debe tener al menos un número";
            cargando = false;
            return;
        }

        if (!password.Any(c => !char.IsLetterOrDigit(c)))
        {
            mensajeError = "La contraseña debe tener al menos un símbolo (!@#$%...)";
            cargando = false;
            return;
        }

        if (password != confirmPassword)
        {
            mensajeError = "Las contraseñas no coinciden";
            cargando = false;
            return;
        }

        if (string.IsNullOrEmpty(rol))
        {
            mensajeError = "Selecciona un rol";
            cargando = false;
            return;
        }

        try
        {
            var success = await AuthService.RegisterAsync(nombre, apellidos, email, password, telefono, rol);

            if (success)
            {
                mensajeCorrecto = "Cuenta creada correctamente. Redirigiendo...";
                await Task.Delay(1500);
                Navigation.NavigateTo("/login");
            }
            else
            {
                mensajeError = "El email ya está registrado";
            }
        }
        catch
        {
            mensajeError = "Error al conectar con el servidor";
        }

        cargando = false;
    }
}