@page "/login"
@layout EmptyLayout
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<div class="login-page">
    <div class="login-wrapper">
        <div class="login-image"></div>
        <div class="login-form">
            <MudText Typo="Typo.h4" Class="text-gradient mb-2" Align="Align.Center">Gestión Pisos</MudText>
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Align="Align.Center" Class="mb-6">Inicia sesión en tu cuenta</MudText>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@mensajeError</MudAlert>
            }

            <MudTextField @bind-Value="email" Label="Email" Variant="Variant.Outlined"
                          InputType="InputType.Email" Class="mb-3" />

            <MudTextField @bind-Value="password" Label="Contraseña" Variant="Variant.Outlined"
                          InputType="InputType.Password" Class="mb-4" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
                       OnClick="Acceso" Disabled="@cargando"
                       Style="width: 100%; height: 48px; border-radius: 8px; font-size: 1rem;">
                @if (cargando)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Cargando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </MudButton>

            <MudText Align="Align.Center">
                <MudLink Href="/register">¿No tienes cuenta? Regístrate aquí</MudLink>
            </MudText>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string mensajeError = "";
    private bool cargando = false;

    private async Task Acceso()
    {
        cargando = true;
        mensajeError = "";

        try
        {
            var success = await AuthService.LoginAsync(email, password);

            if (success)
            {
                Navigation.NavigateTo("/dashboard", forceLoad: true);
            }
            else
            {
                mensajeError = "Email o contraseña incorrectos";
            }
        }
        catch
        {
            mensajeError = "Error al conectar con el servidor";
        }

        cargando = false;
    }
}