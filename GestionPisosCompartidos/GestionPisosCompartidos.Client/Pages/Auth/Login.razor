@page "/login"
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<div class="login-container">
    <h2>Iniciar sesión</h2>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }

    <div class="form-group">
        <label>Email</label>
        <input type="email" class="form-control" @bind="email" />
    </div>

    <div class="form-group">
        <label>Contraseña</label>
        <input type="password" class="form-control" @bind="password" />
    </div>

    <button class="btn btn-primary" @onclick="Acceso" disabled="@cargando">
        @if (cargando)
        {
            <span>Cargando...</span>
        }
        else
        {
            <span>Entrar</span>
        }
    </button>

    <p class="mt-3">¿No tienes cuenta? <a href="/register">Regístrate aquí</a></p>
</div>

@code {
    private string email = "";
    private string password = "";
    private string mensajeError = "";
    private bool cargando = false;

    private async Task Acceso()
    {
        cargando = true;
        mensajeError = "";

        try
        {
            var success = await AuthService.LoginAsync(email, password);

            if (success)
            {
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                mensajeError = "Email o contraseña incorrectos";
            }
        }
        catch
        {
            mensajeError = "Error al conectar con el servidor";
        }

        cargando = false;
    }
}