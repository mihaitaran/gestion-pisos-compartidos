@page "/login"
@layout EmptyLayout
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation


<div class="login-page">
    <MudCard Class="login-card" Elevation="4">
        <MudCardHeader>
            <MudText Typo="Typo.h4" Align="Align.Center" Class="w-100">Gestión Pisos</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-4">Iniciar sesión</MudText>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@mensajeError</MudAlert>
            }

            <MudTextField @bind-Value="email" Label="Email" Variant="Variant.Outlined"
                          InputType="InputType.Email" Class="mb-3" />

            <MudTextField @bind-Value="password" Label="Contraseña" Variant="Variant.Outlined"
                          InputType="InputType.Password" Class="mb-4" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="w-100"
                       OnClick="Acceso" Disabled="@cargando">
                @if (cargando)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Cargando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </MudButton>
        </MudCardContent>
        <MudCardActions Class="justify-center">
            <MudLink Href="/register">¿No tienes cuenta? Regístrate aquí</MudLink>
        </MudCardActions>
    </MudCard>
</div>

@code {
    private string email = "";
    private string password = "";
    private string mensajeError = "";
    private bool cargando = false;

    private async Task Acceso()
    {
        cargando = true;
        mensajeError = "";

        try
        {
            var success = await AuthService.LoginAsync(email, password);

            if (success)
            {
                Navigation.NavigateTo("/dashboard", forceLoad: true);
            }
            else
            {
                mensajeError = "Email o contraseña incorrectos";
            }
        }
        catch
        {
            mensajeError = "Error al conectar con el servidor";
        }

        cargando = false;
    }
}