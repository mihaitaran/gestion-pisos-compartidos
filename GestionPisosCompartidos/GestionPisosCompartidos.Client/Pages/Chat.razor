@page "/chat"
@inject HttpClient Http
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Configuration
@implements IAsyncDisposable

<MudText Typo="Typo.h4" Class="mb-4">Chat de la vivienda</MudText>

@if (rol == "Propietario")
{
    <MudSelect T="int" Value="viviendaSeleccionada" Label="Selecciona vivienda" Variant="Variant.Outlined" Class="mb-4" Style="max-width: 400px;" ValueChanged="CambiarVivienda">
        <MudSelectItem Value="0">Selecciona vivienda</MudSelectItem>
        @foreach (var v in viviendas)
        {
            <MudSelectItem Value="@v.Id">@v.Direccion - @v.Ciudad</MudSelectItem>
        }
    </MudSelect>
}
else if (viviendaActiva != null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Vivienda: @viviendaActiva.Direccion - @viviendaActiva.Ciudad
    </MudAlert>
}

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@mensajeAlerta</MudAlert>
}

@if (viviendaSeleccionada > 0)
{
    <MudPaper id="chat-container" Class="chat-container pa-4 mb-4" Elevation="2">
        @if (mensajes.Count == 0)
        {
            <MudText Align="Align.Center" Color="Color.Secondary">No hay mensajes aún. ¡Empieza la conversación!</MudText>
        }
        else
        {
            @foreach (var m in mensajes)
            {
                <div class="d-flex @(m.EmisorId == usuarioId ? "justify-end" : "justify-start") mb-2">
                    <MudPaper Class="chat-mensaje pa-3" Elevation="1" Style="@(m.EmisorId == usuarioId ? "background-color: #E3F2FD;" : "")">
                        <MudText Typo="Typo.caption" Color="Color.Primary">
                            <b>@m.Emisor?.Nombre @m.Emisor?.Apellidos</b>
                        </MudText>
                        <MudText Typo="Typo.body1">@m.Contenido</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatHelper.FormatFechaHora(m.FechaEnvio)</MudText>
                    </MudPaper>
                </div>
            }
        }
    </MudPaper>

    <MudGrid>
        <MudItem xs="10">
            <MudTextField @bind-Value="nuevoMensaje" Label="Escribe un mensaje..." Variant="Variant.Outlined"
                          OnKeyUp="EnviarConEnter" />
        </MudItem>
        <MudItem xs="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="EnviarMensaje">Enviar</MudButton>
        </MudItem>
    </MudGrid>
}
else if (rol == "Inquilino" && viviendaActiva == null)
{
    <MudAlert Severity="Severity.Warning">No tienes una vivienda asignada.</MudAlert>
}

@code {
    private HubConnection? hubConnection;
    private List<MensajeDTO> mensajes = new();
    private List<ViviendaDTO> viviendas = new();
    private ViviendaDTO? viviendaActiva = null;
    private int viviendaSeleccionada = 0;
    private int viviendaAnterior = 0;
    private int usuarioId = 0;
    private string nuevoMensaje = "";
    private string mensajeAlerta = "";
    private string rol = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await IniciarSignalR();
            await CargarViviendas();
            StateHasChanged();
        }
    }

    private async Task IniciarSignalR()
    {
        var token = await AuthService.GetTokenAsync();
        var apiUrl = Configuration["ApiUrl"] ?? "https://localhost:7024";

        hubConnection = new HubConnectionBuilder()
            .WithUrl($"{apiUrl}/chathub", options =>
            {
                options.AccessTokenProvider = () => Task.FromResult(token);
            })
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<MensajeDTO>("RecibirMensaje", async (mensaje) =>
        {
            if (!mensajes.Any(m => m.Id == mensaje.Id))
            {
                mensajes.Add(mensaje);
                await InvokeAsync(StateHasChanged);
                await ScrollAlFinal();
            }
        });

        try
        {
            await hubConnection.StartAsync();
        }
        catch
        {
            mensajeAlerta = "No se pudo conectar al chat en tiempo real";
        }
    }

    private async Task CambiarVivienda(int nuevaVivienda)
    {
        if (viviendaAnterior > 0 && hubConnection != null)
        {
            await hubConnection.InvokeAsync("SalirDeVivienda", viviendaAnterior);
        }

        viviendaSeleccionada = nuevaVivienda;
        viviendaAnterior = nuevaVivienda;

        if (viviendaSeleccionada > 0 && hubConnection != null)
        {
            await hubConnection.InvokeAsync("UnirseAVivienda", viviendaSeleccionada);
        }

        await CargarMensajes();
    }

    private async Task CargarViviendas()
    {
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user == null) return;

            usuarioId = user.UsuarioId;
            rol = user.Rol;

            if (rol == "Propietario")
            {
                viviendas = await Http.GetFromJsonAsync<List<ViviendaDTO>>($"api/viviendas/propietario/{user.UsuarioId}") ?? new();
            }
            else
            {
                var asignaciones = await Http.GetFromJsonAsync<List<InquilinoViviendaDTO>>($"api/inquilinosviviendas/inquilino/{user.UsuarioId}") ?? new();
                var activa = asignaciones.FirstOrDefault(a => a.Activo);

                if (activa?.Vivienda != null)
                {
                    viviendaActiva = activa.Vivienda;
                    viviendaSeleccionada = activa.ViviendaId;
                    viviendaAnterior = activa.ViviendaId;

                    if (hubConnection != null)
                    {
                        await hubConnection.InvokeAsync("UnirseAVivienda", viviendaSeleccionada);
                    }

                    await CargarMensajes();
                }
            }
        }
        catch
        {
            mensajeAlerta = "Error al cargar viviendas";
        }
    }

    private async Task CargarMensajes()
    {
        if (viviendaSeleccionada == 0) { mensajes = new(); return; }

        try
        {
            mensajes = await Http.GetFromJsonAsync<List<MensajeDTO>>($"api/mensajes/vivienda/{viviendaSeleccionada}") ?? new();
            await ScrollAlFinal();
        }
        catch
        {
            mensajeAlerta = "Error al cargar mensajes";
        }
    }

    private async Task EnviarMensaje()
    {
        if (string.IsNullOrEmpty(nuevoMensaje) || viviendaSeleccionada == 0) return;

        try
        {
            var data = new { ViviendaId = viviendaSeleccionada, EmisorId = usuarioId, Contenido = nuevoMensaje };
            var response = await Http.PostAsJsonAsync("api/mensajes", data);

            if (response.IsSuccessStatusCode)
            {
                nuevoMensaje = "";
                await CargarMensajes();
            }
            else
            {
                mensajeAlerta = "Error al enviar mensaje";
            }
        }
        catch
        {
            mensajeAlerta = "Error al enviar";
        }
    }

    private async Task EnviarConEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await EnviarMensaje();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private async Task ScrollAlFinal()
    {
        await JS.InvokeVoidAsync("scrollToBottom", "chat-container");
    }
}