@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudNavMenu>
    <MudNavLink Href="/menu" Icon="@Icons.Material.Filled.Dashboard">Menu</MudNavLink>

    @if (rol == "Propietario")
    {
        <MudNavLink Href="/viviendas" Icon="@Icons.Material.Filled.Home">Viviendas</MudNavLink>
        <MudNavLink Href="/gastos" Icon="@Icons.Material.Filled.Receipt">Gastos</MudNavLink>
        <MudNavLink Href="/pagos" Icon="@Icons.Material.Filled.Payment">Pagos</MudNavLink>
        <MudNavLink Href="/incidencias" Icon="@Icons.Material.Filled.Warning">Incidencias</MudNavLink>
    }
    else if (rol == "Inquilino")
    {
        <MudNavLink Href="/gastos" Icon="@Icons.Material.Filled.Receipt">Gastos</MudNavLink>
        <MudNavLink Href="/mis-pagos" Icon="@Icons.Material.Filled.Payment">Mis pagos</MudNavLink>
        <MudNavLink Href="/mis-incidencias" Icon="@Icons.Material.Filled.Warning">Incidencias</MudNavLink>
    }

    <MudNavLink Href="/calendario" Icon="@Icons.Material.Filled.CalendarMonth">Calendario</MudNavLink>
    <MudNavLink Href="/chat" Icon="@Icons.Material.Filled.Chat">Chat</MudNavLink>
</MudNavMenu>

@code {
    private string rol = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var uri = Navigation.Uri.ToLower();
            if (!uri.Contains("/login") && !uri.Contains("/register"))
            {
                var user = await AuthService.GetUserAsync();
                if (user != null)
                {
                    rol = user.Rol;
                    StateHasChanged();
                }
            }
        }
    }
}