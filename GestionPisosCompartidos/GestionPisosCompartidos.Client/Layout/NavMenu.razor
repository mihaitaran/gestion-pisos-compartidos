@inject GestionPisosCompartidos.Client.Services.AuthService AuthService

<MudNavMenu Class="mt-2">
    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary">
        Dashboard
    </MudNavLink>

    @if (rol == "Propietario")
    {
        <MudText Typo="Typo.overline" Class="nav-seccion">GESTIÓN</MudText>
        <MudNavLink Href="/viviendas" Icon="@Icons.Material.Filled.Home" IconColor="Color.Primary">Viviendas</MudNavLink>
        <MudNavLink Href="/gastos" Icon="@Icons.Material.Filled.Receipt" IconColor="Color.Info">Gastos</MudNavLink>
        <MudNavLink Href="/pagos" Icon="@Icons.Material.Filled.Payment" IconColor="Color.Success">Pagos</MudNavLink>
        <MudNavLink Href="/incidencias" Icon="@Icons.Material.Filled.Warning" IconColor="Color.Warning">Incidencias</MudNavLink>
    }
    else if (rol == "Inquilino")
    {
        <MudText Typo="Typo.overline" Class="nav-seccion">MI VIVIENDA</MudText>
        <MudNavLink Href="/gastos" Icon="@Icons.Material.Filled.Receipt" IconColor="Color.Info">Gastos</MudNavLink>
        <MudNavLink Href="/mis-pagos" Icon="@Icons.Material.Filled.Payment" IconColor="Color.Success">Mis pagos</MudNavLink>
        <MudNavLink Href="/mis-incidencias" Icon="@Icons.Material.Filled.Warning" IconColor="Color.Warning">Incidencias</MudNavLink>
    }

    <MudText Typo="Typo.overline" Class="px-4 mt-4 mb-1" Style="color: var(--color-text-secondary);">HERRAMIENTAS</MudText>
    <MudNavLink Href="/calendario" Icon="@Icons.Material.Filled.CalendarMonth" IconColor="Color.Primary">Calendario</MudNavLink>
    <MudNavLink Href="/chat" Icon="@Icons.Material.Filled.Chat" IconColor="Color.Secondary">Chat</MudNavLink>
    <MudNavLink Href="/lugares" Icon="@Icons.Material.Filled.Place" IconColor="Color.Error">Lugares cercanos</MudNavLink>
    <MudNavLink Href="/perfil" Icon="@Icons.Material.Filled.Person" IconColor="Color.Primary">Mi perfil</MudNavLink>
</MudNavMenu>

@code {
    private string rol = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var user = await AuthService.GetUserAsync();
            if (user != null)
            {
                rol = user.Rol;
                StateHasChanged();
            }
        }
    }
}