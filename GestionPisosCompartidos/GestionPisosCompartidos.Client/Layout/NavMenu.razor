@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

@if (mostrarMenu)
{
    <div class="nav-menu">
        <nav>
            <a href="/dashboard">Dashboard</a>

            @if (rol == "Propietario")
            {
                <a href="/viviendas">Viviendas</a>
                <a href="/gastos">Gastos</a>
                <a href="/pagos">Pagos</a>
                <a href="/incidencias">Incidencias</a>
                <a href="/chat">Chat</a>
            }
            else if (rol == "Inquilino")
            {
                <a href="/mis-pagos">Mis pagos</a>
                <a href="/gastos">Gastos</a>
                <a href="/mis-incidencias">Incidencias</a>
                <a href="/calendario">Calendario</a>
                <a href="/chat">Chat</a>
            }
        </nav>
    </div>
}

@code {
    private string rol = "";
    private bool mostrarMenu = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var uri = Navigation.Uri.ToLower();
            mostrarMenu = !uri.Contains("/login") && !uri.Contains("/register");

            if (mostrarMenu)
            {
                var user = await AuthService.GetUserAsync();
                if (user != null)
                {
                    rol = user.Rol;
                }
            }
            StateHasChanged();
        }
    }
}