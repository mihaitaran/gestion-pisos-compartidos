@inherits LayoutComponentBase
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudLayout>
    @if (mostrarLayout)
    {
        <MudAppBar Elevation="2" Class="appbar-gradient">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
            <MudText Typo="Typo.h6" Class="appbar-title">RoomMate</MudText>
            <MudSpacer />
            @if (usuario != null)
            {
                <MudHidden Breakpoint="Breakpoint.Xs" Invert="false">
                    <MudChip T="string" Size="Size.Small" Class="appbar-chip">@usuario.Rol</MudChip>
                    <MudText Class="appbar-username">@usuario.Nombre</MudText>
                </MudHidden>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="CerrarSesion" Title="Cerrar sesión" />
            }
        </MudAppBar>

        <MudDrawer @bind-Open="drawerOpen" Elevation="3" ClipMode="DrawerClipMode.Always" Breakpoint="Breakpoint.Md" Variant="DrawerVariant.Responsive">
            <div class="sidebar-header">
                <MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Large" Style="color: white;" />
                <MudText Typo="Typo.subtitle1" Style="color: white; font-weight: 600;">Menú</MudText>
            </div>
            <NavMenu />
        </MudDrawer>
    }

    <MudMainContent Class="pa-4" Style="background: var(--color-bg); min-height: 100vh;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private GestionPisosCompartidos.Client.Services.UserData? usuario;
    private bool mostrarLayout = false;
    private bool drawerOpen = true;

    protected override async Task OnParametersSetAsync()
    {
        var uri = Navigation.Uri.ToLower();
        mostrarLayout = !uri.Contains("/login") && !uri.Contains("/register");

        if (mostrarLayout)
        {
            try
            {
                var autenticado = await AuthService.IsAuthenticatedAsync();
                if (!autenticado)
                {
                    Navigation.NavigateTo("/login");
                    return;
                }
                usuario = await AuthService.GetUserAsync();
            }
            catch { }
        }
        else
        {
            usuario = null;
        }
    }

    private void ToggleDrawer()
    {
        drawerOpen = !drawerOpen;
    }

    private async Task CerrarSesion()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}