@inherits LayoutComponentBase
@inject GestionPisosCompartidos.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<MudLayout>
    @if (mostrarLayout)
    {
        <MudAppBar Elevation="2" Style="background: linear-gradient(90deg, #1565C0, #0D47A1);">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
            <MudText Typo="Typo.h6" Style="font-weight: 600;">Gestión Pisos Compartidos</MudText>
            <MudSpacer />
            @if (usuario != null)
            {
                <MudChip T="string" Size="Size.Small" Style="background: rgba(255,255,255,0.2); color: white;">
                    @usuario.Rol
                </MudChip>
                <MudText Class="mx-3" Style="color: white;">@usuario.Nombre</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           Style="color: white; border-color: rgba(255,255,255,0.5);"
                           OnClick="CerrarSesion">Cerrar sesión</MudButton>
            }
        </MudAppBar>

        <MudDrawer @bind-Open="drawerOpen" Elevation="3" ClipMode="DrawerClipMode.Always" Breakpoint="Breakpoint.Md" Variant="DrawerVariant.Responsive">
            <div class="sidebar-header">
                <MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Large" Style="color: white;" />
                <MudText Typo="Typo.subtitle1" Style="color: white; font-weight: 600;">Menú</MudText>
            </div>
            <NavMenu />
        </MudDrawer>
    }

    <MudMainContent Class="pa-4" Style="background: var(--color-bg); min-height: 100vh;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private GestionPisosCompartidos.Client.Services.UserData? usuario;
    private bool mostrarLayout = false;
    private bool drawerOpen = true;

    protected override async Task OnParametersSetAsync()
    {
        var uri = Navigation.Uri.ToLower();
        mostrarLayout = !uri.Contains("/login") && !uri.Contains("/register");

        if (mostrarLayout)
        {
            try
            {
                var autenticado = await AuthService.IsAuthenticatedAsync();
                if (!autenticado)
                {
                    Navigation.NavigateTo("/login");
                    return;
                }
                usuario = await AuthService.GetUserAsync();
            }
            catch { }
        }
        else
        {
            usuario = null;
        }
    }

    private void ToggleDrawer()
    {
        drawerOpen = !drawerOpen;
    }

    private async Task CerrarSesion()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}