@page "/register"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="register-container">
    <h2>Crear cuenta</h2>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <div class="form-group">
        <label>Nombre</label>
        <input type="text" class="form-control" @bind="nombre" />
    </div>

    <div class="form-group">
        <label>Apellidos</label>
        <input type="text" class="form-control" @bind="apellidos" />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="email" class="form-control" @bind="email" />
    </div>

    <div class="form-group">
        <label>Contraseña</label>
        <input type="password" class="form-control" @bind="password" />
    </div>

    <div class="form-group">
        <label>Confirmar contraseña</label>
        <input type="password" class="form-control" @bind="confirmPassword" />
    </div>

    <div class="form-group">
        <label>Teléfono</label>
        <input type="text" class="form-control" @bind="telefono" />
    </div>

    <div class="form-group">
        <label>Rol</label>
        <select class="form-control" @bind="rol">
            <option value="">Selecciona un rol</option>
            <option value="Propietario">Propietario</option>
            <option value="Inquilino">Inquilino</option>
        </select>
    </div>

    <button class="btn btn-primary" @onclick="Registro">
            <span>Registrarse</span>
    </button>

    <p class="mt-3">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
</div>

@code {
    private string nombre = "";
    private string apellidos = "";
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private string telefono = "";
    private string rol = "";
    private string errorMessage = "";
    private string successMessage = "";

    private async Task Registro()
    {
        errorMessage = "";
        successMessage = "";

        if (password != confirmPassword)
        {
            errorMessage = "Las contraseñas no coinciden";
            return;
        }

        if (string.IsNullOrEmpty(rol))
        {
            errorMessage = "Selecciona un rol";
            return;
        }

        try
        {
            var registroData = new
            {
                Nombre = nombre,
                Apellidos = apellidos,
                Email = email,
                Password = password,
                Telefono = telefono,
                Rol = rol
            };

            var response = await Http.PostAsJsonAsync("api/auth/register", registroData);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Cuenta creada correctamente. Redirigiendo...";
                await Task.Delay(1500);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = "El email ya está registrado";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al conectar con el servidor";
        }
    }
}